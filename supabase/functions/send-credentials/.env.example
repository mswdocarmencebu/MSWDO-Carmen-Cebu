# Supabase Edge Function Secrets for Resend
# Set these in your Supabase project using Supabase CLI or Dashboard:
#
# Using Supabase CLI:
# supabase secrets set RESEND_API_KEY="re_123456789" RESEND_SENDER_EMAIL="MSWDO Carmen <onboarding@resend.dev>"
#
# Or in Supabase Dashboard:
# Project Settings -> Edge Functions -> Secrets

# Your Resend API key (from https://resend.com/api-keys)
RESEND_API_KEY=re_your_api_key_here

# Sender Email
# For initial testing before domain verification: "MSWDO Carmen <onboarding@resend.dev>"
# For production (after verifying your domain in Resend): "MSWDO Carmen <no-reply@yourdomain.com>"
RESEND_SENDER_EMAIL="MSWDO Carmen <onboarding@resend.dev>"
