# Supabase Configuration Example
# Copy this file to .env and fill in your actual Supabase project credentials:
# cp .env.example .env

# Your Supabase Project URL (Find in Supabase Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Your Supabase Public Anonymous API Key (Anon Public key safe for client-side use)
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Optional Application Configuration
VITE_APP_NAME="MSWDO | Municipal Social Welfare and Development Office"
VITE_APP_ENV=development

# Email Configuration (Resend)
VITE_ENABLE_LIVE_EMAIL=true
# Paste your Resend API Key here (starts with re_...) from https://resend.com/api-keys
VITE_RESEND_API_KEY=your-resend-api-key-here
VITE_RESEND_SENDER_EMAIL="MSWDO Carmen <no-reply@swu-som.com>"
VITE_RESEND_REPLY_TO=mswdo.carmencebu5@gmail.com

